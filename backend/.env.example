NODE_ENV=development
PORT=4100
HOST=0.0.0.0
# Round 4 — one catalog DB + one file per company, see backend/.env's comment.
CATALOG_DATABASE_URL="file:./catalog.db"
# Dev-only — builds the per-company template DB, never used at runtime.
COMPANY_DATABASE_URL="file:./template.db"
JWT_SECRET="change-me-to-a-random-32-plus-character-secret"
JWT_TTL_HOURS=12
# Support Login validates against Supabase Auth — publishable/anon key only,
# never the service_role key (Settings -> API in the Supabase dashboard).
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="sb_publishable_..."
