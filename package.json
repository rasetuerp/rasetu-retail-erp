{
  "name": "rasetu-retail-erp",
  "private": true,
  "version": "0.1.1",
  "description": "RetailBilling by Rasetu — cloth store v1, generic retail later",
  "author": "Rasetu",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "preelectron": "tsc -p tsconfig.electron.json",
    "electron": "electron .",
    "build:client-app": "tsc -b && npm --prefix backend run build && npm --prefix backend run db:prepare && vite build && tsc -p tsconfig.electron.json && electron-builder --dir",
    "build:electron": "npm run lint && tsc -b && npm --prefix backend run build && npm --prefix backend run db:prepare && vite build && tsc -p tsconfig.electron.json && electron-builder && echo \"Build complete: release-customer/RaSetu-ERP-Setup-*.exe\"",
    "backend:dev": "npm --prefix backend run dev",
    "backend:build": "npm --prefix backend run build",
    "db:generate": "npm --prefix backend run prisma:generate",
    "db:migrate": "npm --prefix backend run prisma:migrate",
    "db:studio": "npm --prefix backend run prisma:studio"
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "jsbarcode": "^3.12.3",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "lucide-react": "^1.8.0",
    "node-machine-id": "^1.1.12",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "serialport": "^13.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "^24.12.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4"
  }
}
